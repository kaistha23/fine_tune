CR_DATABASE_PATH=data/curated/credit_risk.duckdb
CR_SCHEMA_REGISTRY=configs/schema_registry.yaml
CR_SCHEMA_REGISTRY_VERSION=1.1.0
CR_ARCHITECTURE_POLICY=configs/architecture_policy.yaml
CR_ARCHITECTURE_POLICY_VERSION=1.0.0
CR_SERVICE_ROLE=api_gateway
CR_SERVICE_TOKEN=local-dev-only-change-me
